generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  TENANT_ADMIN
  MEMBER
  FREELANCER
}

enum TenantStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum ProductCategory {
  SAAS_TOOL
  COMPONENT_LIBRARY
  TEMPLATE
  PLUGIN
  API_SERVICE
  EBOOK
  COURSE_BUNDLE
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ChatType {
  DIRECT
  GROUP
  CHANNEL
}

enum NotificationType {
  SYSTEM
  TENANT
  JOB
  PAYMENT
  CHAT
  APPROVAL
}

enum TransactionType {
  SUBSCRIPTION
  PRODUCT_SALE
  ESCROW_DEPOSIT
  ESCROW_RELEASE
  REFUND
  PLATFORM_FEE
  JOB_FEATURE_FEE
  JOB_COMMISSION
}

enum CommissionStatus {
  UNPAID
  INVOICED
  PAID
  WAIVED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model User {
  id            String   @id @default(cuid()) @db.VarChar(30)
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  avatarUrl     String?  @map("avatar_url")
  bio           String?  @db.Text
  role          UserRole @default(MEMBER)
  isActive      Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")
  language      String   @default("en")
  timezone      String   @default("UTC")
  paypalEmail   String?  @map("paypal_email")
  githubUrl     String?  @map("github_url")
  linkedinUrl   String?  @map("linkedin_url")
  portfolioUrl  String?  @map("portfolio_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenantId String? @map("tenant_id") @db.VarChar(30)
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  ownedTenants    Tenant[]         @relation("TenantOwner")
  courses         Course[]         @relation("CourseInstructor")
  products        Product[]        @relation("ProductSeller")
  jobListings     JobListing[]     @relation("JobPoster")
  jobApplications JobApplication[] @relation("ApplicantUser")
  chatMessages    ChatMessage[]    @relation("MessageSender")
  sentInvites     TenantInvite[]   @relation("InviteSender")
  notifications   Notification[]   @relation("NotificationUser")
  reviews         Review[]         @relation("ReviewAuthor")
  auditLogs       AuditLog[]       @relation("AuditUser")
  forumThreads    ForumThread[]    @relation("ThreadAuthor")
  forumPosts      ForumPost[]      @relation("PostAuthor")
  forumVotes      ForumVote[]      @relation("VoteAuthor")

  @@index([email])
  @@index([tenantId])
  @@index([role])
  @@map("users")
}

model Tenant {
  id                 String           @id @default(cuid()) @db.VarChar(30)
  name               String
  slug               String           @unique
  subdomain          String           @unique
  description        String?          @db.Text
  industry           String?
  companySize        String?          @map("company_size")
  foundedYear        Int?             @map("founded_year")
  websiteUrl         String?          @map("website_url")
  logoUrl            String?          @map("logo_url")
  bannerUrl          String?          @map("banner_url")
  status             TenantStatus     @default(PENDING_APPROVAL)
  subscriptionTier   SubscriptionTier @default(FREE) @map("subscription_tier")
  subscriptionEndsAt DateTime?        @map("subscription_ends_at")
  paypalMerchantId   String?          @map("paypal_merchant_id")
  verificationDocUrl String?          @map("verification_doc_url")
  taxId              String?          @map("tax_id")
  billingAddress     String?          @map("billing_address") @db.Text
  isVerified         Boolean          @default(false) @map("is_verified")
  socialLinks        Json?            @map("social_links")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  ownerId         String          @map("owner_id") @db.VarChar(30)
  owner           User            @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         User[]
  courses         Course[]
  products        Product[]
  jobListings     JobListing[]
  chatRooms       ChatRoom[]
  invites         TenantInvite[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  forumCategories ForumCategory[]
  forumThreads    ForumThread[]

  @@index([slug])
  @@index([subdomain])
  @@index([status])
  @@index([subscriptionTier])
  @@map("tenants")
}

model TenantInvite {
  id        String    @id @default(cuid()) @db.VarChar(30)
  email     String    @db.VarChar(100)
  token     String    @unique
  role      UserRole  @default(MEMBER)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenantId  String @map("tenant_id") @db.VarChar(30)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy String @map("invited_by") @db.VarChar(30)
  sender    User   @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("tenant_invites")
}

model Course {
  id               String   @id @default(cuid()) @db.VarChar(30)
  title            String
  slug             String   @db.VarChar(100)
  description      String   @db.Text
  thumbnailUrl     String?  @map("thumbnail_url")
  price            Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD")
  isPublished      Boolean  @default(false) @map("is_published")
  moduleCount      Int      @default(0) @map("module_count")
  durationMinutes  Int      @default(0) @map("duration_minutes")
  difficulty       String   @default("BEGINNER")
  rating           Decimal? @db.Decimal(3, 2)
  enrollCount      Int      @default(0) @map("enroll_count")
  tags             Json?    @default("[]")
  prerequisites    Json?    @default("[]")
  learningOutcomes Json?    @default("[]") @map("learning_outcomes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenantId     String         @map("tenant_id") @db.VarChar(30)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instructorId String         @map("instructor_id") @db.VarChar(30)
  instructor   User           @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  modules      CourseModule[]
  reviews      Review[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([isPublished])
  @@map("courses")
}

model CourseModule {
  id              String   @id @default(cuid()) @db.VarChar(30)
  title           String
  description     String?  @db.Text
  orderIndex      Int      @map("order_index")
  durationMinutes Int      @default(0) @map("duration_minutes")
  isPreview       Boolean  @default(false) @map("is_preview")
  videoUrl        String?  @map("video_url")
  createdAt       DateTime @default(now()) @map("created_at")

  courseId String @map("course_id") @db.VarChar(30)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_modules")
}

model Product {
  id          String          @id @default(cuid()) @db.VarChar(30)
  name        String
  slug        String          @db.VarChar(100)
  description String          @db.Text
  shortDesc   String?         @map("short_desc")
  category    ProductCategory
  price       Decimal         @db.Decimal(10, 2)
  currency    String          @default("USD")
  imageUrls   Json?           @default("[]") @map("image_urls")
  downloadUrl String?         @map("download_url")
  demoUrl     String?         @map("demo_url")
  isActive    Boolean         @default(true) @map("is_active")
  salesCount  Int             @default(0) @map("sales_count")
  rating      Decimal?        @db.Decimal(3, 2)
  tags        Json?           @default("[]")
  version     String?         @default("1.0.0")
  changelog   String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenantId String   @map("tenant_id") @db.VarChar(30)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerId String   @map("seller_id") @db.VarChar(30)
  seller   User     @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  reviews  Review[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([category])
  @@index([isActive])
  @@map("products")
}

model Review {
  id        String   @id @default(cuid()) @db.VarChar(30)
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  authorId  String   @map("author_id") @db.VarChar(30)
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  courseId  String?  @map("course_id") @db.VarChar(30)
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  productId String?  @map("product_id") @db.VarChar(30)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([productId])
  @@map("reviews")
}

model JobListing {
  id               String    @id @default(cuid()) @db.VarChar(30)
  title            String
  slug             String    @db.VarChar(100)
  description      String    @db.Text
  requirements     String    @db.Text
  responsibilities String?   @db.Text
  budgetMin        Decimal?  @map("budget_min") @db.Decimal(10, 2)
  budgetMax        Decimal?  @map("budget_max") @db.Decimal(10, 2)
  currency         String    @default("USD")
  status           JobStatus @default(OPEN)
  escrowAmount     Decimal?  @map("escrow_amount") @db.Decimal(10, 2)
  escrowReleased   Boolean   @default(false) @map("escrow_released")
  paypalOrderId    String?   @map("paypal_order_id")
  location         String?
  isRemote         Boolean   @default(true) @map("is_remote")
  skillsRequired   Json?     @default("[]") @map("skills_required")
  experienceLevel  String?   @map("experience_level")
  deadline         DateTime?
  featured         Boolean   @default(false) @map("featured")
  featuredUntil    DateTime? @map("featured_until")
  featuredFee      Decimal?  @map("featured_fee") @db.Decimal(10, 2)
  commissionRate   Decimal   @default(10.00) @map("commission_rate") @db.Decimal(10, 2)
  commissionAmount Decimal?  @map("commission_amount") @db.Decimal(10, 2)
  commissionStatus CommissionStatus @default(UNPAID) @map("commission_status")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenantId     String           @map("tenant_id") @db.VarChar(30)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postedById   String           @map("posted_by_id") @db.VarChar(30)
  postedBy     User             @relation("JobPoster", fields: [postedById], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([featured, featuredUntil])
  @@map("job_listings")
}

model JobApplication {
  id           String   @id @default(cuid()) @db.VarChar(30)
  coverLetter  String   @map("cover_letter") @db.Text
  proposedRate Decimal? @map("proposed_rate") @db.Decimal(10, 2)
  currency     String   @default("USD")
  status       String   @default("PENDING")
  attachments  Json?    @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  jobId       String     @map("job_id") @db.VarChar(30)
  job         JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String     @map("applicant_id") @db.VarChar(30)
  applicant   User       @relation("ApplicantUser", fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@map("job_applications")
}

model ChatRoom {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String?
  type      ChatType @default(DIRECT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantId     String            @map("tenant_id") @db.VarChar(30)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  participants ChatParticipant[]

  @@index([tenantId])
  @@map("chat_rooms")
}

model ChatParticipant {
  id         String   @id @default(cuid()) @db.VarChar(30)
  roomId     String   @map("room_id") @db.VarChar(30)
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.VarChar(30)
  joinedAt   DateTime @default(now()) @map("joined_at")
  lastReadAt DateTime @default(now()) @map("last_read_at")

  @@unique([roomId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id          String   @id @default(cuid()) @db.VarChar(30)
  content     String   @db.Text
  roomId      String   @map("room_id") @db.VarChar(30)
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String   @map("sender_id") @db.VarChar(30)
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments Json?    @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(cuid()) @db.VarChar(30)
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  userId   String  @map("user_id") @db.VarChar(30)
  user     User    @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  tenantId String? @map("tenant_id") @db.VarChar(30)
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model PlatformTransaction {
  id              String            @id @default(cuid()) @db.VarChar(30)
  paypalOrderId   String            @unique @map("paypal_order_id")
  paypalCaptureId String?           @map("paypal_capture_id")
  amount          Decimal           @db.Decimal(10, 2)
  platformFee     Decimal           @map("platform_fee") @db.Decimal(10, 2)
  sellerPayout    Decimal           @map("seller_payout") @db.Decimal(10, 2)
  currency        String            @default("USD")
  status          TransactionStatus @default(PENDING)
  type            TransactionType
  tenantId        String?           @map("tenant_id") @db.VarChar(30)
  userId          String?           @map("user_id") @db.VarChar(30)
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([paypalOrderId])
  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@map("platform_transactions")
}

model AuditLog {
  id        String   @id @default(cuid()) @db.VarChar(30)
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.VarChar(30)
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  userId   String? @map("user_id") @db.VarChar(30)
  user     User?   @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)
  tenantId String? @map("tenant_id") @db.VarChar(30)
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Forum System ───
model ForumCategory {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String
  slug        String   @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @default("MessageCircle")
  color       String?  @default("#3b82f6")
  orderIndex  Int      @default(0) @map("order_index")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantId String        @map("tenant_id") @db.VarChar(30)
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  threads  ForumThread[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([isActive])
  @@map("forum_categories")
}

model ForumThread {
  id        String   @id @default(cuid()) @db.VarChar(30)
  title     String
  slug      String   @db.VarChar(100)
  content   String   @db.Text
  isPinned  Boolean  @default(false) @map("is_pinned")
  isLocked  Boolean  @default(false) @map("is_locked")
  viewCount Int      @default(0) @map("view_count")
  postCount Int      @default(0) @map("post_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantId   String        @map("tenant_id") @db.VarChar(30)
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String        @map("category_id") @db.VarChar(30)
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId   String        @map("author_id") @db.VarChar(30)
  author     User          @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  posts      ForumPost[]
  votes      ForumVote[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
  @@index([isPinned])
  @@index([createdAt])
  @@map("forum_threads")
}

model ForumPost {
  id         String   @id @default(cuid()) @db.VarChar(30)
  content    String   @db.Text
  isSolution Boolean  @default(false) @map("is_solution")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  threadId String      @map("thread_id") @db.VarChar(30)
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId String      @map("author_id") @db.VarChar(30)
  author   User        @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  votes    ForumVote[]

  @@index([threadId])
  @@index([authorId])
  @@map("forum_posts")
}

model ForumVote {
  id        String   @id @default(cuid()) @db.VarChar(30)
  type      String // "UP" | "DOWN"
  createdAt DateTime @default(now()) @map("created_at")

  userId   String       @map("user_id") @db.VarChar(30)
  user     User         @relation("VoteAuthor", fields: [userId], references: [id], onDelete: Cascade)
  threadId String?      @map("thread_id") @db.VarChar(30)
  thread   ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  postId   String?      @map("post_id") @db.VarChar(30)
  post     ForumPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@unique([userId, postId])
  @@map("forum_votes")
}
